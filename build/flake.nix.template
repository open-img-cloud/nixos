{
  description = "NixOS OpenStack image build configuration";

  # Pinned at build time by nix-build.sh: `nixos-VERSION` is replaced
  # with the concrete release branch (e.g. `nixos-26.05`).
  inputs.nixpkgs.url = "github:NixOS/nixpkgs/nixos-VERSION";

  outputs = { self, nixpkgs, ... }:
    let
      nixos = nixpkgs.lib.nixosSystem {
        system = "x86_64-linux";
        modules = [
          # Pin nixpkgs to the flake input, so packages installed in the
          # built image come from inputs.nixpkgs.url.
          ({ ... }: { nix.registry.nixpkgs.flake = nixpkgs; })

          # `system.stateVersion` controls stateful-data defaults
          # (file paths, DB on-disk formats). Pinned to the release we
          # track; keep it unless the README explicitly says otherwise.
          ({ ... }: { system.stateVersion = "VERSION"; })

          ./config.nix

          # Native image framework (nixpkgs >= 25.05, replaces
          # nix-community/nixos-generators): register our own variant
          # next to the built-in ones. The built-in `openstack` variant
          # bakes the whole nixpkgs channel into an uncompressed qcow2;
          # `openstack-slim` does not (see openstack-slim.nix).
          ({ ... }: { image.modules.openstack-slim = ./openstack-slim.nix; })
        ];
      };
    in
    {
      nixosConfigurations.openstack = nixos;
      packages.x86_64-linux.openstack = nixos.config.system.build.images.openstack-slim;
    };
}
